# Reverse proxy in front of Postiz, used by the `caddy` compose profile.
# Certificates are obtained and renewed automatically from Let's Encrypt, so
# MAIN_DOMAIN must already resolve to this server before the container starts.
#
# MAIN_DOMAIN and LETSENCRYPT_EMAIL are passed in from .env by
# docker-compose.prod.yaml.

{
	email {$LETSENCRYPT_EMAIL}
}

{$MAIN_DOMAIN} {
	encode zstd gzip

	# Matches the 2G client_max_body_size the app's own nginx allows.
	request_body {
		max_size 2GB
	}

	# The app serves the frontend, the API and /uploads on a single port.
	reverse_proxy postiz:5000
}
