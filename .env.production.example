# Postiz production configuration — template for docker-compose.prod.yaml.
#
# Copy it to `.env` (or just run `make init`, which also generates the
# secrets), then fill in MAIN_URL and POSTIZ_BIND. See DEPLOY.md.
#
# Note: DATABASE_URL, REDIS_URL, FRONTEND_URL, NEXT_PUBLIC_BACKEND_URL,
# BACKEND_INTERNAL_URL, TEMPORAL_ADDRESS and the upload directories are
# derived from the values below by docker-compose.prod.yaml — don't set them
# here, they would be ignored.

# === Required Settings

# The exact public URL users open Postiz on, without a trailing slash. TLS is
# terminated on the reverse proxy, so this is https:// even though this VM
# only serves plain HTTP:  https://postiz.example.com
MAIN_URL=

# Generated by `make init` — long random strings.
JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_POSTGRES_PASSWORD=

# === Stack Settings

# Optional services: elasticsearch (Temporal advanced visibility, ~1GB RAM),
# tools (Temporal UI on localhost:8080).
COMPOSE_PROFILES=elasticsearch
# Must be false whenever `elasticsearch` is not in COMPOSE_PROFILES.
TEMPORAL_ENABLE_ES=true

# Image tag to run. Pin it to a release (e.g. v1.47.0) to control upgrades.
POSTIZ_VERSION=latest

# Address the reverse proxy VM connects to. Use this VM's private-network IP
# (e.g. 10.0.0.5) so the app is not reachable from the internet directly;
# 0.0.0.0 only if a firewall already limits access to the proxy.
POSTIZ_BIND=127.0.0.1
POSTIZ_PORT=4007

# Database name and user. Keep the defaults unless you are reusing an existing
# volume that was created with different ones.
POSTGRES_USER=postiz-user
POSTGRES_DB=postiz-db-local

# === Registration

# Set to true once your own account exists, so the instance stays private.
DISABLE_REGISTRATION=false

# === Storage Settings

# local — files are kept in the postiz-uploads volume and served by the app.
STORAGE_PROVIDER=local

# === Cloudflare (R2) Settings — only when STORAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKETNAME=
# CLOUDFLARE_BUCKET_URL=
# CLOUDFLARE_REGION=auto

# === Email (optional)
# When RESEND_API_KEY is set, new users must confirm their email address.
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=

# === Social Media API Settings
# Fill in only the networks you actually connect. The redirect URL of each app
# is MAIN_URL + /integrations/social/<provider>.
X_URL=
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# === Misc Settings
OPENAI_API_KEY=
NEXT_PUBLIC_DISCORD_SUPPORT=
NEXT_PUBLIC_POLOTNO=
API_LIMIT=30
NX_ADD_PLUGINS=false

# === Payment / Stripe Settings
FEE_AMOUNT=0.05
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_SIGNING_KEY=
STRIPE_SIGNING_KEY_CONNECT=

# === OAuth & Authentik Settings (optional single sign-on)
# POSTIZ_GENERIC_OAUTH=false
# NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=Authentik
# NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=
# POSTIZ_OAUTH_URL=
# POSTIZ_OAUTH_AUTH_URL=
# POSTIZ_OAUTH_TOKEN_URL=
# POSTIZ_OAUTH_USERINFO_URL=
# POSTIZ_OAUTH_CLIENT_ID=
# POSTIZ_OAUTH_CLIENT_SECRET=
# POSTIZ_OAUTH_SCOPE=openid profile email

# === Short Link Service Settings (optional)
# DUB_TOKEN=
# DUB_API_ENDPOINT=https://api.dub.co
# DUB_SHORT_LINK_DOMAIN=dub.sh
# SHORT_IO_SECRET_KEY=
# KUTT_API_KEY=
# KUTT_API_ENDPOINT=https://kutt.it/api/v2
# KUTT_SHORT_LINK_DOMAIN=kutt.it
# LINK_DRIP_API_KEY=
# LINK_DRIP_API_ENDPOINT=https://api.linkdrip.com/v1/
# LINK_DRIP_SHORT_LINK_DOMAIN=dripl.ink
